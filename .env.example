# Gobernanza / observabilidad (GOB-GCP-STD-01)
SERVICE_NAME=ms_ia_chatbot
SERVICE_VERSION=1.0.0
# Local: dev. En Cloud Run (pre-qa-functions) se inyecta como "qa" o "prem"
# (ver cloudbuild.yaml / docs/MANUAL.md) — no "preprod"/"prod" genérico.
ENVIRONMENT=dev
LOG_LEVEL=INFO
GOOGLE_CLOUD_PROJECT=

# Gemini API Key con acceso a File Search Store. En Cloud Run se inyecta vía
# Secret Manager (--set-secrets), nunca como variable de entorno plana.
GEMINI_API_KEY=*****

# Proyecto GCP donde viven Firestore (registro de tenants) y el bucket de contexto.
GCP_PROJECT=

# Bucket por defecto donde viven los prefijos de cada tenant (identity.json,
# protocol.json, knowledge/). Cada tenant también puede declarar su propio
# bucket en su documento de Firestore.
TENANT_BUCKET=

# TTL (segundos) del cache en memoria de la config de cada tenant (Firestore -> proceso).
TENANT_CACHE_TTL_SECONDS=90
